modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[deployment.responseHeaders]]
path = "/"
name = "Cache-Control"
value = "public, max-age=0, must-revalidate"

[[deployment.responseHeaders]]
path = "/index.html"
name = "Cache-Control"
value = "public, max-age=0, must-revalidate"

[[deployment.responseHeaders]]
path = "/favicon.png"
name = "Cache-Control"
value = "public, max-age=0, must-revalidate"
